{
  "name": "apartment-scanner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "format:check": "prettier --check . --ignore-unknown --ignore-path .gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:migration:upgrade": "tsx scripts/test-upgrade-migration.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:guard": "tsx scripts/check-e2e-database.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:bootstrap": "tsx prisma/bootstrap.ts",
    "db:e2e:migrate": "npm run test:e2e:guard && prisma migrate deploy",
    "db:e2e:seed": "npm run test:e2e:guard && npm run db:seed",
    "db:seed": "tsx prisma/seed.ts",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.20",
    "@base-ui/react": "^1.6.0",
    "@clerk/nextjs": "^7.6.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sparticuz/chromium": "^149.0.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.48",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "inngest": "^4.14.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "playwright": "^1.62.0",
    "playwright-core": "^1.62.0",
    "postcss": "^8.5.25",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "shadcn": "^4.15.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "$postcss",
    "gaxios": "^7.3.0",
    "next": {
      "sharp": "^0.35.3"
    }
  }
}
